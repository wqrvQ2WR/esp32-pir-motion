// 이 파일을 secrets.h 로 복사한 뒤 본인 와이파이 정보를 채운다.
// secrets.h 는 .gitignore 에 들어 있어 깃헙에 올라가지 않는다.
#pragma once

#define WIFI_SSID "와이파이_이름"
#define WIFI_PASS "와이파이_비밀번호"

// 폰 앱 목록에 표시될 이름. 센서를 여러 개 둘 때 구분용.
#define DEVICE_NAME "esp32-pir"

// ntfy.sh 토픽. 추측 불가능한 긴 이름으로 직접 정한다(이 이름이 곧 비밀번호).
// 예: pir-k3n9x2vq8wz1m5t7r4lp
#define NTFY_TOPIC "pir-아무도_모를_긴_이름"

// ntfy 서버 주소. 공개 서버는 https://ntfy.sh
// 라즈베리파이에 직접 올렸다면 https://pi.taild4dc8e.ts.net:8443 처럼 바꾼다 (끝에 / 없이).
#define NTFY_BASE_URL "https://ntfy.sh"

// 자체 호스팅 ntfy 서버에 인증을 걸었다면 토큰을 넣는다. 공개 ntfy.sh면 빈 문자열로 둔다.
#define NTFY_TOKEN ""
